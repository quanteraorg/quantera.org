# Set these as environment variables on your host (Render, Fly.io, Railway, Docker...). Never commit real keys.
PORT=8080
ALPHAVANTAGE_API_KEY=
MARKETAUX_API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Only needed if the browser calls this server directly instead of through the Vercel rewrite
ALLOWED_ORIGIN=
# Waitlist and usage events (see README: Supabase). Service key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Rebuild /api/markets every N seconds (60+). Leave empty on a free Alpha Vantage key.
MARKET_REFRESH_SEC=
# Recommended: live quotes from Finnhub (free plan: 60 calls/minute, no daily cap). Get a key at finnhub.io.
FINNHUB_API_KEY=
# Recommended: chart history from Twelve Data (free plan: 800 calls/day). Get a key at twelvedata.com.
TWELVEDATA_API_KEY=
# AI: free Google Gemini key from aistudio.google.com (used when set). Optional GEMINI_MODEL (default gemini-flash-latest).
GEMINI_API_KEY=
# Force the AI provider: gemini or anthropic. Unset = Gemini if its key is set, else Anthropic.
AI_PROVIDER=
# Seconds between sparkline series refreshes (Twelve Data). Default 20 keeps well under the 8 calls/minute free limit.
SPARK_WARM_SEC=
# Global markets via Yahoo Finance (no key). Set to 0 to turn off.
YAHOO_ENABLED=
